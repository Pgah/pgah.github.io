---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prompt from '../components/Prompt.astro';
import { getCollection } from 'astro:content';

const PAGE_SIZE = 7;

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// İlk (filtresiz) görünümün sayfa numaraları sunucuda üretiliyor ki açılışta
// numaralar sonradan belirip düzeni oynatmasın. 7'den fazla sayfa olursa
// pencereleme gerekiyor, onu istemci tarafı devralıyor.
const pageCount = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const initialPages = pageCount <= 7
  ? Array.from({ length: pageCount }, (_, i) => i + 1)
  : [];

const postsJson = JSON.stringify(posts.map(p => {
  const d = p.data.date;
  return {
    id: p.id,
    date: p.data.date.valueOf(),
    dateStr: `${String(d.getUTCDate()).padStart(2,'0')}/${String(d.getUTCMonth()+1).padStart(2,'0')}/${d.getUTCFullYear()}`,
    title: p.data.title,
    description: p.data.description,
    tags: p.data.tags,
  };
}));
---

<BaseLayout title="blogs">
  <div class="cursor-line" id="cursor-line">
    <span class="prompt-dim">sleeper@matrix:~/blogs$</span>&nbsp;<input class="terminal-input" id="terminal-input" type="text" autocomplete="off" spellcheck="false" aria-label="terminal" />
  </div>

  <div id="terminal-output"></div>

  <hr />

  <Prompt command="ls -la ~/blogs" />

  <div class="listing">
    <div class="listing-header">
      <span class="col-perm">permissions</span>
      <span class="col-date sort-btn" id="sort-date">date <span class="sort-arrow">↓</span></span>
      <span class="col-name sort-btn" id="sort-name">name <span class="sort-arrow"></span></span>
    </div>

    <div id="listing-body">
      {posts.map((post, i) => {
        const d = post.data.date;
        const dateStr = `${String(d.getUTCDate()).padStart(2,'0')}/${String(d.getUTCMonth()+1).padStart(2,'0')}/${d.getUTCFullYear()}`;
        return (
          <div class="listing-row" style={i >= PAGE_SIZE ? 'display:none' : undefined}>
            <span class="col-perm perm">-rw-r--r--</span>
            <span class="col-date date">{dateStr}</span>
            <div class="col-name-wrap">
              <a class="col-name" href={`/posts/${post.id}`}>{post.data.title}</a>
              {post.data.tags.length > 0 && (
                <span class="tags-inline">
                  {post.data.tags.map(tag => (
                    <button class="tag-chip" data-tag={tag} type="button">[{tag}]</button>
                  ))}
                </span>
              )}
            </div>
          </div>
        );
      })}
    </div>

    {posts.length === 0 && (
      <div class="listing-row empty-row">
        <span class="col-perm perm">──────────</span>
        <span class="col-date date">──────────</span>
        <span class="col-name muted">──────────</span>
      </div>
    )}
  </div>

  <div class="pager" id="pager" hidden={posts.length <= PAGE_SIZE}>
    <span class="pager-pages" id="pager-pages">
      {initialPages.map((n) => (
        <button
          class={n === 1 ? 'pager-num pager-num-active' : 'pager-num'}
          data-page={n - 1}
          type="button"
        >{n}</button>
      ))}
    </span>
  </div>

  <script type="application/json" id="posts-data" set:html={postsJson}></script>
</BaseLayout>

<script>
  import { findCommand, commandNames, type CommandCtx } from '../lib/commands';

  const posts = JSON.parse(document.getElementById('posts-data').textContent);
  const PAGE_SIZE = 7;
  let sortKey = 'date';
  let sortDir = -1;
  let activeTag = null;
  let page = 0;
  const cmdHistory = [];
  let historyIndex = -1;

  const body = document.getElementById('listing-body');
  const btnDate = document.getElementById('sort-date');
  const btnName = document.getElementById('sort-name');
  const termInput = document.getElementById('terminal-input');
  const termOutput = document.getElementById('terminal-output');
  const cursorLine = document.getElementById('cursor-line');
  const pager = document.getElementById('pager');
  const pagerPages = document.getElementById('pager-pages');

  const rows = Array.from(body.querySelectorAll('.listing-row'));
  rows.forEach((row, i) => {
    row.dataset.date = posts[i].date;
    row.dataset.id = posts[i].id;
    row.dataset.tags = posts[i].tags.join(',');
  });

  function thirdWord(id) {
    return id.split('-').slice(2).join('-');
  }

  function setActiveTag(tag) {
    activeTag = tag;
    page = 0;
    document.querySelectorAll('.tag-chip').forEach(c => {
      c.classList.toggle('tag-active', c.dataset.tag === tag);
    });
    render();
  }

  // Sayfa sayısı büyüdükçe hepsini yan yana dizmek yerine pencereliyoruz:
  // ilk, son, bulunduğun sayfa ve komşuları — aradaki boşluklar '…' oluyor.
  function pageWindow(current, count) {
    if (count <= 7) return Array.from({ length: count }, (_, i) => i + 1);
    const picked = [1, count, current, current - 1, current + 1]
      .filter(n => n >= 1 && n <= count)
      .sort((a, b) => a - b);

    const out = [];
    let prev = 0;
    for (const n of picked) {
      if (n === prev) continue;
      if (prev && n - prev > 1) out.push('…');
      out.push(n);
      prev = n;
    }
    return out;
  }

  function renderPageNumbers(pageCount) {
    pagerPages.textContent = '';
    for (const entry of pageWindow(page + 1, pageCount)) {
      if (entry === '…') {
        const gap = document.createElement('span');
        gap.className = 'pager-gap';
        gap.textContent = '…';
        pagerPages.appendChild(gap);
        continue;
      }
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = entry === page + 1 ? 'pager-num pager-num-active' : 'pager-num';
      btn.dataset.page = String(entry - 1);
      btn.textContent = String(entry);
      if (entry === page + 1) btn.setAttribute('aria-current', 'page');
      pagerPages.appendChild(btn);
    }
  }

  function render() {
    const sorted = [...rows].sort((a, b) => {
      if (sortKey === 'date') return (Number(a.dataset.date) - Number(b.dataset.date)) * sortDir;
      return thirdWord(a.dataset.id).localeCompare(thirdWord(b.dataset.id)) * sortDir;
    });

    // Etiket filtresinden geçenler; sayfalama bu küme üzerinden yürüyor.
    const matching = sorted.filter(row => {
      const tags = row.dataset.tags ? row.dataset.tags.split(',') : [];
      return !activeTag || tags.includes(activeTag);
    });

    const pageCount = Math.max(1, Math.ceil(matching.length / PAGE_SIZE));
    page = Math.min(Math.max(page, 0), pageCount - 1);

    const start = page * PAGE_SIZE;
    const shown = new Set(matching.slice(start, start + PAGE_SIZE));

    sorted.forEach(row => {
      row.style.display = shown.has(row) ? '' : 'none';
      body.appendChild(row);
    });

    pager.hidden = matching.length <= PAGE_SIZE;
    renderPageNumbers(pageCount);

    btnDate.querySelector('.sort-arrow').textContent = sortKey === 'date' ? (sortDir === -1 ? '↓' : '↑') : '';
    btnName.querySelector('.sort-arrow').textContent = sortKey === 'name' ? (sortDir === -1 ? '↓' : '↑') : '';
  }

  pagerPages.addEventListener('click', (e) => {
    const btn = e.target.closest('.pager-num');
    if (!btn) return;
    page = Number(btn.dataset.page);
    render();
  });

  btnDate.addEventListener('click', () => {
    if (sortKey === 'date') sortDir *= -1;
    else { sortKey = 'date'; sortDir = -1; }
    page = 0;
    render();
  });

  btnName.addEventListener('click', () => {
    if (sortKey === 'name') sortDir *= -1;
    else { sortKey = 'name'; sortDir = 1; }
    page = 0;
    render();
  });

  // Sunucudan tüm satırlar geliyor; ilk sayfayı burada kırpıyoruz.
  render();

  body.addEventListener('click', (e) => {
    const chip = e.target.closest('.tag-chip');
    if (!chip) return;
    setActiveTag(activeTag === chip.dataset.tag ? null : chip.dataset.tag);
  });

  cursorLine.addEventListener('click', () => termInput.focus());

  function esc(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  let currentGroup = null;

  function addLine(html) {
    const div = document.createElement('div');
    div.className = 'term-out-line';
    div.innerHTML = html;
    currentGroup.appendChild(div);
  }

  function newGroup() {
    currentGroup = document.createElement('div');
    currentGroup.className = 'term-group';
    termOutput.appendChild(currentGroup);
  }

  function tagSpan(t) {
    return `<span class="term-tag">[${esc(t)}]</span>`;
  }

  const ctx = {
    posts,
    history: cmdHistory,
    addLine,
    navigate: (url) => { window.location.href = url; },
    clearOutput: () => { termOutput.innerHTML = ''; },
    setActiveTag,
    getActiveTag: () => activeTag,
    esc,
    tagSpan,
  } satisfies CommandCtx;

  let tabCycle = null;

  function completeFrom(partial, candidates, prefix) {
    const matches = candidates.filter(x => x.toLowerCase().startsWith(partial.toLowerCase()));
    if (!matches.length) return;
    if (!tabCycle) {
      if (matches.length === 1) { termInput.value = prefix + matches[0]; return; }
      let common = matches[0];
      for (const x of matches) while (!x.startsWith(common)) common = common.slice(0, -1);
      if (common !== partial) { termInput.value = prefix + common; tabCycle = { matches, index: -1, prefix }; }
      else { tabCycle = { matches, index: 0, prefix }; termInput.value = prefix + matches[0]; }
    } else {
      tabCycle.index = (tabCycle.index + 1) % tabCycle.matches.length;
      termInput.value = tabCycle.prefix + tabCycle.matches[tabCycle.index];
    }
  }

  termInput.addEventListener('keydown', async (e) => {
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      tabCycle = null;
      if (historyIndex < cmdHistory.length - 1) {
        historyIndex++;
        termInput.value = cmdHistory[cmdHistory.length - 1 - historyIndex];
      }
      return;
    }
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      tabCycle = null;
      if (historyIndex > 0) {
        historyIndex--;
        termInput.value = cmdHistory[cmdHistory.length - 1 - historyIndex];
      } else {
        historyIndex = -1;
        termInput.value = '';
      }
      return;
    }
    if (e.key === 'Tab') {
      e.preventDefault();
      const val = termInput.value;
      const m = val.match(/^(cd\s+|cat\s+|man\s+)(.*)$/);
      if (m) {
        completeFrom(m[2], posts.map(p => p.id), m[1]);
      } else if (!/\s/.test(val)) {
        completeFrom(val, commandNames, '');
      }
      return;
    }

    tabCycle = null;
    if (e.key !== 'Enter') return;

    const cmdStr = termInput.value.trim();
    termInput.value = '';
    historyIndex = -1;

    newGroup();
    addLine(`<span class="prompt-dim">sleeper@matrix:~/blogs$</span>&nbsp;<span class="term-cmd">${esc(cmdStr)}</span>`);
    if (!cmdStr) return;

    const parts = cmdStr.split(/\s+/);
    const name = parts[0];
    const args = parts.slice(1);
    const argStr = cmdStr.slice(name.length).trim();
    const command = findCommand(name);

    // Record history, but keep secret invocations (e.g. `pwcheck <pw>`) out of it.
    if (!(command && command.secret && argStr)) {
      cmdHistory.push(cmdStr);
      if (cmdHistory.length > 100) cmdHistory.shift();
    }

    if (!command) {
      addLine(`<span class="term-err">bash: ${esc(name)}: command not found — try 'help'</span>`);
      return;
    }

    try {
      await command.run(ctx, args, argStr);
    } catch (err) {
      const msg = err instanceof Error ? err.message : String(err);
      addLine(`<span class="term-err">${esc(name)}: ${esc(msg)}</span>`);
    }
  });
</script>

<style>
.listing { width: 100%; margin-bottom: 2rem; }
.listing-header {
  display: grid;
  grid-template-columns: 16ch 16ch 1fr;
  gap: 0 2ch;
  color: var(--fg-bright);
  font-size: 0.8rem;
  margin-bottom: 0.5rem;
  padding-bottom: 0.25rem;
  border-bottom: 1px solid var(--fg-muted);
}
.listing-header .col-date { padding-left: 9ch; color: var(--fg-bright); }
.listing-header .col-name { padding-left: 25ch; }
.sort-btn { cursor: pointer; user-select: none; }
.sort-btn:hover { color: var(--fg-bright); }
.listing-row {
  display: grid;
  grid-template-columns: 16ch 16ch 1fr;
  gap: 0 2ch;
  padding: 0.15rem 0;
  align-items: baseline;
}
.col-name-wrap {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0 0.5ch;
}
.perm  { color: var(--fg-bright); }
.muted { color: var(--fg-muted); }
.date  { color: var(--fg-bright); }
.col-name { color: var(--fg-bright); }
.tags-inline { display: inline-flex; flex-wrap: wrap; gap: 0 0.4ch; }
.tag-chip {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--fg-muted);
  font-family: var(--font);
  font-size: 0.78rem;
  padding: 0;
  line-height: inherit;
  transition: color 0.15s;
}
.tag-chip:hover { color: var(--fg); }
.tag-chip.tag-active { color: var(--fg-bright); text-decoration: underline; }
/* Terminal sayfanın en üstünde; çıktı hemen altında birikir, böylece
   giriş satırı hiç yer değiştirmez. */
.cursor-line {
  display: flex;
  align-items: center;
  gap: 0.5ch;
  cursor: text;
}
#terminal-output:not(:empty) {
  margin-top: 0.5rem;
}

.pager {
  display: flex;
  justify-content: center;
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px solid var(--fg-muted);
  font-size: 0.9rem;
}
.pager[hidden] { display: none; }

.pager-pages {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 0.5ch;
}

/* Numaralar temanın kendi değişkenlerinden besleniyor, böylece `theme`
   komutuyla altın/matrix/amber arasında geçince de uyumlu kalıyorlar. */
/* Numaralar JS ile üretiliyor, yani Astro'nun scope attribute'unu almıyorlar.
   Bu yüzden :global() ile eşleşiyoruz — kapsam yine sunucudan gelen
   .pager-pages ile sınırlı kaldığı için stil dışarı sızmıyor. */
.pager-pages :global(.pager-num) {
  background: none;
  border: none;
  cursor: pointer;
  font-family: var(--font);
  font-size: inherit;
  line-height: inherit;
  color: var(--fg-dim);
  padding: 0 0.75ch;
  transition: color 0.15s;
}
.pager-pages :global(.pager-num:hover) {
  color: var(--fg-bright);
}
.pager-pages :global(.pager-num-active) {
  color: var(--fg-bright);
  text-decoration: underline;
}
.pager-pages :global(.pager-gap) {
  color: var(--fg-muted);
  padding: 0 0.25ch;
}
.prompt-dim { color: var(--fg-dim); }
.terminal-input {
  background: transparent;
  border: none;
  outline: none;
  color: var(--fg-bright);
  font-family: var(--font);
  font-size: inherit;
  caret-color: var(--fg-bright);
  flex: 1;
  min-width: 0;
}
/* Terminal çıktısının tamamı JS ile üretildiği için burada da :global()
   gerekiyor; kapsam sunucudan gelen #terminal-output ile sınırlı. */
#terminal-output :global(.term-group) { margin-top: 1.5rem; }
#terminal-output :global(.term-out-line) { margin-top: 0.25rem; font-size: inherit; }
#terminal-output :global(.prompt-dim) { color: var(--fg-dim); }
#terminal-output :global(.term-cmd) { color: var(--fg-bright); }
#terminal-output :global(.term-err) { color: #e05252; }
#terminal-output :global(.term-dim) { color: var(--fg-dim); }
#terminal-output :global(.term-desc) { color: var(--fg-muted); font-size: 0.9em; }
#terminal-output :global(.term-link) { color: var(--fg-bright); }
#terminal-output :global(.term-link:hover) { text-decoration: underline; color: #fff; }
#terminal-output :global(.term-tag) { color: var(--fg-muted); font-size: 0.85em; }
#terminal-output :global(.man-section) { color: var(--fg-bright); }
#terminal-output :global(.man-name) { color: var(--fg-bright); font-size: 1.05em; }

@media (max-width: 600px) {
  .listing-header { display: none; }
  .listing-row {
    grid-template-columns: 1fr;
    gap: 0;
    margin-bottom: 1rem;
  }
  .perm { display: none; }
  .col-date { font-size: 0.8rem; color: var(--fg-dim); }
  .col-name-wrap { flex-direction: column; gap: 0.2rem; }
}
</style>
