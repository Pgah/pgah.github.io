---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="wordle" description="Daily security word puzzle — a new 5-letter cyber term every day">

  <div class="wl-page">
    <header class="wl-header">
      <h1 class="wl-title">Security Wordle</h1>
      <div id="wl-meta" class="wl-meta"></div>
    </header>

    <div id="wl-msg" class="wl-msg"></div>

    <div class="wl-grid" id="wl-grid"></div>

    <div class="wl-keyboard" id="wl-keyboard"></div>

    <div id="wl-actions" class="wl-actions"></div>
  </div>

</BaseLayout>

<script>
  import {
    getDailyWord, dayIndex, loadState, saveState, evaluateGuess,
    isValidGuess, buildShareText, todayStr,
  } from '../lib/wordle';

  const state  = loadState();
  const target = getDailyWord();
  const day    = dayIndex();

  let currentGuess = '';
  let msgTimer: ReturnType<typeof setTimeout> | null = null;

  // ── DOM refs ──────────────────────────────────────────────────────────────
  const metaEl    = document.getElementById('wl-meta')!;
  const msgEl     = document.getElementById('wl-msg')!;
  const gridEl    = document.getElementById('wl-grid')!;
  const kbEl      = document.getElementById('wl-keyboard')!;
  const actionsEl = document.getElementById('wl-actions')!;

  // ── Grid init (30 static cells) ───────────────────────────────────────────
  for (let r = 0; r < 6; r++) {
    for (let c = 0; c < 5; c++) {
      const cell = document.createElement('div');
      cell.id = `c${r}${c}`;
      gridEl.appendChild(cell);
    }
  }

  // ── Keyboard init ─────────────────────────────────────────────────────────
  const KB_ROWS = ['QWERTYUIOP', 'ASDFGHJKL', '↵ZXCVBNM⌫'];

  function buildKeyboard() {
    kbEl.innerHTML = '';
    for (const letters of KB_ROWS) {
      const row = document.createElement('div');
      row.className = 'kb-row';
      for (const ch of letters) {
        const btn = document.createElement('button');
        btn.className = ch === '↵' || ch === '⌫' ? 'kb-key kb-wide' : 'kb-key';
        btn.textContent = ch;
        btn.dataset.key = ch;
        btn.addEventListener('click', () => handleKey(ch));
        row.appendChild(btn);
      }
      kbEl.appendChild(row);
    }
  }

  // ── Render ────────────────────────────────────────────────────────────────
  function renderMeta() {
    const streak = state.streak > 0 ? ` · streak&nbsp;${state.streak}&nbsp;🔥` : '';
    metaEl.innerHTML = `#${day} &nbsp;·&nbsp; ${state.date}${streak}`;
  }

  function renderGrid() {
    const activeRow = state.guesses.length;
    for (let r = 0; r < 6; r++) {
      for (let c = 0; c < 5; c++) {
        const cell = document.getElementById(`c${r}${c}`)!;
        if (r < state.guesses.length) {
          cell.textContent = state.guesses[r][c];
          cell.className   = `cell cell-${state.results[r][c]}`;
        } else if (r === activeRow && !state.solved && !state.failed) {
          cell.textContent = currentGuess[c] ?? '';
          cell.className   = currentGuess[c] ? 'cell cell-input' : 'cell cell-empty';
        } else {
          cell.textContent = '';
          cell.className   = 'cell cell-empty';
        }
      }
    }
  }

  function renderKeyboard() {
    const ks: Record<string, string> = {};
    for (let g = 0; g < state.guesses.length; g++) {
      for (let i = 0; i < 5; i++) {
        const ch = state.guesses[g][i];
        const r  = state.results[g][i];
        if (!ks[ch] || r === 'correct' || (r === 'present' && ks[ch] === 'absent')) ks[ch] = r;
      }
    }
    kbEl.querySelectorAll<HTMLButtonElement>('.kb-key[data-key]').forEach(btn => {
      const ch = btn.dataset.key!;
      btn.className = btn.classList.contains('kb-wide')
        ? `kb-key kb-wide${ks[ch] ? ' kb-' + ks[ch] : ''}`
        : `kb-key${ks[ch] ? ' kb-' + ks[ch] : ''}`;
    });
  }

  function renderActions() {
    actionsEl.innerHTML = '';
    if (state.solved || state.failed) {
      const btn = document.createElement('button');
      btn.className   = 'wl-share-btn';
      btn.textContent = 'Share result';
      btn.addEventListener('click', doShare);
      actionsEl.appendChild(btn);
    } else if (!state.hintUsed) {
      const btn = document.createElement('button');
      btn.className   = 'wl-hint-btn';
      btn.textContent = 'Hint';
      btn.addEventListener('click', doHint);
      actionsEl.appendChild(btn);
    }
  }

  function renderStatus() {
    if (state.solved) {
      showMsg(`Solved in ${state.guesses.length}/6!`, 'win', 0);
    } else if (state.failed) {
      showMsg(`The word was ${target}`, 'err', 0);
    }
  }

  function render() {
    renderMeta();
    renderGrid();
    renderKeyboard();
    renderActions();
    renderStatus();
  }

  // ── Messages ──────────────────────────────────────────────────────────────
  function showMsg(text: string, type: 'info' | 'err' | 'win' = 'info', duration = 2000) {
    if (msgTimer) clearTimeout(msgTimer);
    msgEl.textContent = text;
    msgEl.className   = `wl-msg wl-msg-${type}`;
    if (duration > 0) {
      msgTimer = setTimeout(() => {
        msgEl.textContent = '';
        msgEl.className   = 'wl-msg';
      }, duration);
    }
  }

  // ── Game actions ──────────────────────────────────────────────────────────
  function doHint() {
    if (state.hintUsed || state.solved || state.failed) return;
    const known = new Set<number>();
    for (const r of state.results) r.forEach((v, i) => { if (v === 'correct') known.add(i); });
    const unknown = [0, 1, 2, 3, 4].filter(i => !known.has(i));
    if (!unknown.length) return;
    const pos = unknown[Math.floor(Math.random() * unknown.length)];
    state.hintUsed = true;
    saveState(state);
    showMsg(`Position ${pos + 1} is "${target[pos]}"`, 'info', 3000);
    renderActions();
  }

  function doShare() {
    const text = buildShareText(state, day);
    navigator.clipboard.writeText(text)
      .then(() => showMsg('Copied!', 'win'))
      .catch(() => showMsg('Clipboard access denied', 'err'));
  }

  function submitGuess() {
    if (state.solved || state.failed || !currentGuess) return;
    if (currentGuess.length !== 5) { showMsg('Not enough letters', 'err'); return; }
    if (!isValidGuess(currentGuess)) { showMsg('Not in word list', 'err'); return; }

    const result = evaluateGuess(currentGuess, target);
    state.guesses.push(currentGuess);
    state.results.push(result);

    if (currentGuess === target) {
      state.solved = true;
      state.streak++;
      state.lastWin = todayStr();
    } else if (state.guesses.length >= 6) {
      state.failed = true;
      state.streak = 0;
    }

    currentGuess = '';
    saveState(state);
    render();
  }

  function addLetter(ch: string) {
    if (state.solved || state.failed || currentGuess.length >= 5) return;
    currentGuess += ch;
    renderGrid();
  }

  function deleteLetter() {
    if (!currentGuess.length) return;
    currentGuess = currentGuess.slice(0, -1);
    renderGrid();
  }

  function handleKey(key: string) {
    if (key === '↵' || key === 'Enter')         submitGuess();
    else if (key === '⌫' || key === 'Backspace') deleteLetter();
    else if (/^[A-Z]$/.test(key))               addLetter(key);
  }

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.key === 'Enter')                        submitGuess();
    else if (e.key === 'Backspace')               deleteLetter();
    else if (/^[a-zA-Z]$/.test(e.key))           addLetter(e.key.toUpperCase());
  });

  buildKeyboard();
  render();
</script>

<style>
  .wl-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding-top: 0.5rem;
  }

  /* Header */
  .wl-header { text-align: center; }
  .wl-title  { font-size: 1.1rem; font-weight: bold; color: var(--fg-bright); margin: 0 0 0.25rem; letter-spacing: 0.05em; }
  .wl-meta   { font-size: 0.8rem; color: var(--fg-dim); }

  /* Message */
  .wl-msg        { height: 1.4rem; font-size: 0.85rem; text-align: center; }
  .wl-msg-info   { color: var(--fg-dim); }
  .wl-msg-err    { color: #e05252; }
  .wl-msg-win    { color: var(--green); }

  /* Grid */
  .wl-grid {
    display: grid;
    grid-template-columns: repeat(5, 3.25rem);
    grid-template-rows: repeat(6, 3.25rem);
    gap: 0.35rem;
  }

  .cell {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    font-weight: bold;
    border: 2px solid;
    text-transform: uppercase;
    user-select: none;
  }

  .cell-empty   { border-color: var(--fg-muted);  color: transparent; background: transparent; }
  .cell-input   { border-color: var(--fg-dim);    color: var(--fg-bright); background: transparent; }
  .cell-correct { border-color: var(--green);     color: var(--bg); background: var(--green); }
  .cell-present { border-color: var(--fg-bright); color: var(--bg); background: var(--fg-bright); }
  .cell-absent  { border-color: #2a2500;          color: var(--fg-muted); background: #2a2500; }

  /* Keyboard */
  .wl-keyboard { display: flex; flex-direction: column; align-items: center; gap: 0.45rem; }
  .kb-row      { display: flex; gap: 0.45rem; }

  .kb-key {
    height: 4rem;
    min-width: 3rem;
    padding: 0 0.4rem;
    border: 1px solid var(--fg-muted);
    background: #1c1a00;
    color: var(--fg-bright);
    font-family: var(--font);
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    border-radius: 0;
    transition: background 0.1s, color 0.1s;
    user-select: none;
  }
  .kb-wide      { min-width: 4.5rem; font-size: 0.85rem; }
  .kb-key:hover { background: var(--fg-muted); color: var(--bg); }

  .kb-correct  { background: var(--green);     color: var(--bg); border-color: var(--green); }
  .kb-present  { background: var(--fg);        color: var(--bg); border-color: var(--fg); }
  .kb-absent   { background: #0e0d00; color: #2e2a00; border-color: #1a1800; }

  /* Actions */
  .wl-actions    { display: flex; gap: 0.75rem; }

  .wl-share-btn,
  .wl-hint-btn {
    background: none;
    border: 1px solid var(--fg-muted);
    color: var(--fg-dim);
    font-family: var(--font);
    font-size: 0.85rem;
    cursor: pointer;
    padding: 0.35rem 1.2rem;
    transition: color 0.1s, border-color 0.1s;
  }
  .wl-share-btn:hover,
  .wl-hint-btn:hover {
    color: var(--fg-bright);
    border-color: var(--fg);
  }

  @media (max-width: 420px) {
    .wl-grid {
      grid-template-columns: repeat(5, 2.8rem);
      grid-template-rows: repeat(6, 2.8rem);
      gap: 0.3rem;
    }
    .cell { font-size: 1.2rem; }
    .kb-key { height: 2.8rem; min-width: 1.9rem; font-size: 0.75rem; }
    .kb-wide { min-width: 3rem; }
  }
</style>
