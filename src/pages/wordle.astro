---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="wordle" description="Daily security word puzzle — a new 5-letter cyber term every day">
  <div class="wl-wrap">

    <header class="wl-header">
      <h1 class="wl-title">Security Wordle</h1>
      <div id="wl-meta" class="wl-meta"></div>
    </header>

    <div id="wl-msg" class="wl-msg"></div>

    <div id="wl-answer" class="wl-answer"></div>

    <div class="wl-grid" id="wl-grid"></div>

    <div id="wl-actions" class="wl-actions"></div>

    <div class="wl-keyboard" id="wl-keyboard"></div>

  </div>
</BaseLayout>

<script>
  import {
    getDailyWord, dayIndex, loadState, saveState, evaluateGuess,
    isValidGuess, buildShareText, todayStr,
  } from '../lib/wordle';

  const state  = loadState();
  const target = getDailyWord();
  const day    = dayIndex();

  let currentGuess = '';
  let msgTimer: ReturnType<typeof setTimeout> | null = null;

  const metaEl    = document.getElementById('wl-meta')!;
  const msgEl     = document.getElementById('wl-msg')!;
  const answerEl  = document.getElementById('wl-answer')!;
  const gridEl    = document.getElementById('wl-grid')!;
  const kbEl      = document.getElementById('wl-keyboard')!;
  const actionsEl = document.getElementById('wl-actions')!;

  // ── Grid ─────────────────────────────────────────────────────────────────
  for (let r = 0; r < 6; r++) {
    for (let c = 0; c < 5; c++) {
      const cell = document.createElement('div');
      cell.id = `c${r}${c}`;
      gridEl.appendChild(cell);
    }
  }

  // ── Keyboard ──────────────────────────────────────────────────────────────
  const KB_ROWS = ['QWERTYUIOP', 'ASDFGHJKL', 'ENTER|ZXCVBNM|⌫'];

  function buildKeyboard() {
    kbEl.innerHTML = '';
    for (const rowStr of KB_ROWS) {
      const keys = rowStr.split('|').flatMap(seg =>
        seg === 'ENTER' ? ['ENTER'] : seg === '⌫' ? ['⌫'] : seg.split('')
      );
      const row = document.createElement('div');
      row.className = 'kb-row';
      for (const ch of keys) {
        const btn = document.createElement('button');
        const isWide = ch === 'ENTER' || ch === '⌫';
        btn.className = isWide ? 'kb-key kb-wide' : 'kb-key';
        btn.textContent = ch;
        btn.dataset.key = ch;
        btn.addEventListener('click', () => handleKey(ch));
        row.appendChild(btn);
      }
      kbEl.appendChild(row);
    }
  }

  // ── Render ────────────────────────────────────────────────────────────────
  function renderMeta() {
    const streak = state.streak > 0 ? ` &nbsp;·&nbsp; streak ${state.streak} 🔥` : '';
    metaEl.innerHTML = `#${day} &nbsp;·&nbsp; ${state.date}${streak}`;
  }

  function renderGrid() {
    const activeRow = state.guesses.length;
    for (let r = 0; r < 6; r++) {
      for (let c = 0; c < 5; c++) {
        const cell = document.getElementById(`c${r}${c}`)!;
        if (r < state.guesses.length) {
          cell.textContent = state.guesses[r][c];
          cell.className = `tile tile-${state.results[r][c]}`;
        } else if (r === activeRow && !state.solved && !state.failed) {
          cell.textContent = currentGuess[c] ?? '';
          cell.className = currentGuess[c] ? 'tile tile-input' : 'tile tile-empty';
        } else {
          cell.textContent = '';
          cell.className = 'tile tile-empty';
        }
      }
    }
  }

  function renderKeyboard() {
    const ks: Record<string, string> = {};
    for (let g = 0; g < state.guesses.length; g++) {
      for (let i = 0; i < 5; i++) {
        const ch = state.guesses[g][i];
        const r  = state.results[g][i];
        if (!ks[ch] || r === 'correct' || (r === 'present' && ks[ch] === 'absent')) ks[ch] = r;
      }
    }
    kbEl.querySelectorAll<HTMLButtonElement>('[data-key]').forEach(btn => {
      const ch = btn.dataset.key!;
      const isWide = ch === 'ENTER' || ch === '⌫';
      const state_class = ks[ch] ? ` kb-${ks[ch]}` : '';
      btn.className = `kb-key${isWide ? ' kb-wide' : ''}${state_class}`;
    });
  }

  function renderActions() {
    actionsEl.innerHTML = '';
    if (state.solved || state.failed) {
      const btn = document.createElement('button');
      btn.className = 'wl-btn';
      btn.textContent = 'Share result';
      btn.addEventListener('click', doShare);
      actionsEl.appendChild(btn);
    } else if (!state.hintUsed) {
      const btn = document.createElement('button');
      btn.className = 'wl-btn';
      btn.textContent = 'Hint';
      btn.addEventListener('click', doHint);
      actionsEl.appendChild(btn);
    }
  }

  function renderAnswer() {
    answerEl.innerHTML = '';
    if (!state.solved && !state.failed) return;
    target.split('').forEach(ch => {
      const tile = document.createElement('div');
      tile.className = 'tile tile-answer';
      tile.textContent = ch;
      answerEl.appendChild(tile);
    });
  }

  function renderStatus() {
    if (state.solved)      showMsg(`Solved in ${state.guesses.length}/6! 🎉`, 'win', 0);
    else if (state.failed) showMsg('Better luck tomorrow!', 'err', 0);
  }

  function render() {
    renderMeta();
    renderAnswer();
    renderGrid();
    renderKeyboard();
    renderActions();
    renderStatus();
  }

  // ── Messages ──────────────────────────────────────────────────────────────
  function showMsg(text: string, type: 'info' | 'err' | 'win' = 'info', duration = 1800) {
    if (msgTimer) clearTimeout(msgTimer);
    msgEl.textContent = text;
    msgEl.className = `wl-msg wl-msg-${type}`;
    if (duration > 0) msgTimer = setTimeout(() => {
      msgEl.textContent = '';
      msgEl.className = 'wl-msg';
    }, duration);
  }

  // ── Actions ───────────────────────────────────────────────────────────────
  function doHint() {
    if (state.hintUsed || state.solved || state.failed) return;
    const known = new Set<number>();
    for (const r of state.results) r.forEach((v, i) => { if (v === 'correct') known.add(i); });
    const unknown = [0, 1, 2, 3, 4].filter(i => !known.has(i));
    if (!unknown.length) return;
    const pos = unknown[Math.floor(Math.random() * unknown.length)];
    state.hintUsed = true;
    saveState(state);
    showMsg(`Position ${pos + 1} is "${target[pos]}"`, 'info', 3000);
    renderActions();
  }

  function doShare() {
    const text = buildShareText(state, day);
    navigator.clipboard.writeText(text)
      .then(() => showMsg('Copied!', 'win'))
      .catch(() => showMsg('Clipboard access denied', 'err'));
  }

  function submitGuess() {
    if (state.solved || state.failed || !currentGuess) return;
    if (currentGuess.length !== 5) { showMsg('Not enough letters', 'err'); return; }
    if (!isValidGuess(currentGuess))  { showMsg('Not in word list', 'err'); return; }

    const result = evaluateGuess(currentGuess, target);
    state.guesses.push(currentGuess);
    state.results.push(result);

    if (currentGuess === target) {
      state.solved = true; state.streak++; state.lastWin = todayStr();
    } else if (state.guesses.length >= 6) {
      state.failed = true; state.streak = 0;
    }

    currentGuess = '';
    saveState(state);
    render();
  }

  function addLetter(ch: string) {
    if (state.solved || state.failed || currentGuess.length >= 5) return;
    currentGuess += ch;
    renderGrid();
  }

  function deleteLetter() {
    if (!currentGuess.length) return;
    currentGuess = currentGuess.slice(0, -1);
    renderGrid();
  }

  function handleKey(key: string) {
    if (key === 'ENTER')              submitGuess();
    else if (key === '⌫')             deleteLetter();
    else if (/^[A-Z]$/.test(key))    addLetter(key);
  }

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.key === 'Enter')                     submitGuess();
    else if (e.key === 'Backspace')            deleteLetter();
    else if (/^[a-zA-Z]$/.test(e.key))        addLetter(e.key.toUpperCase());
  });

  buildKeyboard();
  render();
</script>

<style>
  /* ── Page ──────────────────────────────────────────────────────────────── */
  .wl-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  /* ── Header ────────────────────────────────────────────────────────────── */
  .wl-header { text-align: center; }
  .wl-title  { font-size: 1.05rem; font-weight: bold; color: var(--fg-bright); margin: 0 0 0.2rem; letter-spacing: 0.08em; }
  .wl-meta   { font-size: 0.78rem; color: var(--fg-dim); }

  /* ── Message ───────────────────────────────────────────────────────────── */
  .wl-msg       { min-height: 1.4rem; font-size: 0.85rem; font-weight: bold; text-align: center; }
  .wl-msg-info  { color: var(--fg-dim); }
  .wl-msg-err   { color: #e05252; }
  .wl-msg-win   { color: var(--green); }

  /* ── Answer reveal ────────────────────────────────────────────────────── */
  .wl-answer {
    display: flex;
    gap: 0.35rem;
    justify-content: center;
    min-height: 0;
  }

  .wl-answer .tile {
    width: 3.8rem;
    height: 3.8rem;
  }

  /* ── Grid ──────────────────────────────────────────────────────────────── */
  .wl-grid {
    display: grid;
    grid-template-columns: repeat(5, 3.8rem);
    grid-template-rows:    repeat(6, 3.8rem);
    gap: 0.35rem;
  }

  .tile {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    font-weight: bold;
    text-transform: uppercase;
    border: 2px solid;
    user-select: none;
  }

  .tile-empty   { background: #181500; border-color: #605800; color: transparent; }
  .tile-input   { background: var(--bg-soft); border-color: var(--fg-bright); color: var(--fg-bright); }
  .tile-correct { background: var(--green);      border-color: var(--green);      color: var(--bg); }
  .tile-present { background: var(--fg-bright);  border-color: var(--fg-bright);  color: var(--bg); }
  .tile-absent  { background: #252200;           border-color: #252200;           color: var(--fg-muted); }
  .tile-answer  { background: #181500; border-color: #605800; color: var(--fg-bright); }

  /* ── Actions ───────────────────────────────────────────────────────────── */
  .wl-actions { min-height: 2rem; display: flex; align-items: center; }
  .wl-btn {
    background: none;
    border: 1px solid var(--fg-muted);
    color: var(--fg-dim);
    font-family: var(--font);
    font-size: 0.85rem;
    cursor: pointer;
    padding: 0.3rem 1.2rem;
    transition: color 0.1s, border-color 0.1s;
  }
  .wl-btn:hover { color: var(--fg-bright); border-color: var(--fg); }

  /* ── Keyboard ──────────────────────────────────────────────────────────── */
  .wl-keyboard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .kb-row {
    display: flex;
    gap: 0.4rem;
    justify-content: center;
  }

  .kb-key {
    height: 3.6rem;
    min-width: 2.4rem;
    padding: 0 0.35rem;
    border: 2px solid var(--fg-dim);
    background: #1c1a00;
    color: var(--fg-bright);
    font-family: var(--font);
    font-size: 0.85rem;
    font-weight: bold;
    cursor: pointer;
    user-select: none;
    transition: background 0.1s, color 0.1s;
  }

  .kb-wide { min-width: 4rem; font-size: 0.75rem; }

  .kb-key:hover   { background: var(--fg-muted); color: var(--bg); }
  .kb-correct     { background: var(--green);     color: var(--bg); border-color: var(--green); }
  .kb-present     { background: var(--fg);        color: var(--bg); border-color: var(--fg); }
  .kb-absent      { background: #0e0d00; color: #2a2600; border-color: #1a1800; }

  /* ── Mobile ────────────────────────────────────────────────────────────── */
  @media (max-width: 480px) {
    .wl-grid {
      grid-template-columns: repeat(5, 3rem);
      grid-template-rows:    repeat(6, 3rem);
      gap: 0.25rem;
    }
    .tile    { font-size: 1.25rem; }
    .kb-key  { height: 3rem; min-width: 1.9rem; padding: 0 0.2rem; font-size: 0.75rem; }
    .kb-wide { min-width: 3.25rem; font-size: 0.65rem; }
  }
</style>
